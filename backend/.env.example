# CHAMBA Environment Variables Template
# Copia este archivo a backend/.env y ajusta los valores locales según tu entorno.
# NUNCA agregues contraseñas reales ni credenciales de producción en este archivo.

# Configuración del Servidor Backend (NestJS)
PORT=3000
NODE_ENV=development

# Configuración de PostgreSQL y Prisma ORM
# Se recomienda usar un usuario de aplicación dedicado (chamba_app) con permisos mínimos:
# Formato: postgresql://<USUARIO>:<CONTRASEÑA>@<HOST>:<PUERTO>/<NOMBRE_DB>?schema=public
DATABASE_URL="postgresql://chamba_app:TU_PASSWORD_AQUI@localhost:5432/chamba_db?schema=public"

# Seguridad y Autenticación JWT (Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET="genera_un_token_aleatorio_de_alta_entropia_no_adivinable"
JWT_EXPIRES_IN="7d"

# Configuración de Redis (WebSockets Pub/Sub Adapter y Sesiones Efímeras)
# Formato: redis://<HOST>:<PUERTO>
REDIS_URL="redis://localhost:6379"

# Configuración de URLs para Clientes (Flutter)
# Postman / Web: http://localhost:3000
# Emulador Android (AVD): http://10.0.2.2:3000
# Dispositivo Físico: http://<IP_LOCAL_DE_TU_PC>:3000

# Cloudflare R2 / AWS S3 Compatible Storage (Presigned URLs)
# Endpoint R2: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID="tu_cloudflare_account_id"
R2_ACCESS_KEY_ID="tu_r2_access_key_id"
R2_SECRET_ACCESS_KEY="tu_r2_secret_access_key"
R2_BUCKET_NAME="chamba-uploads"
R2_PUBLIC_URL="https://pub-chamba.r2.dev"
# Opcional para emulación local con MinIO/LocalStack:
# R2_ENDPOINT="http://localhost:9000"

# Google Gemini API (Diagnóstico Visual de Averías con IA)
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy_TU_CLAVE_DE_GEMINI_AQUI"
GEMINI_MODEL="gemini-2.5-flash"
